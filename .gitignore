# ─────────────────────────────────────────────────────────────────────────
#  Big Bad Wolf — media is now version-controlled via Git LFS (see
#  .gitattributes). The heavy stuff under assets/ (images, video, audio) is
#  tracked as LFS objects so it can be synced between collaborators.
# ─────────────────────────────────────────────────────────────────────────

# OS / editor junk
.DS_Store
Thumbs.db

# Secrets & environment
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.log*

# Editor / agent config (local only)
.claude/

# Vercel CLI local link state
.vercel/

# Wolf VO incremental generation cache
.vo-cache.json
