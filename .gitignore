# ─────────────────────────────────────────────────────────────────────────
#  Big Bad Wolf — keep the repo LEAN: track code/text only, never media.
#  All the heavy stuff (images, video, audio) lives in assets/ and is
#  regenerable, so it's intentionally NOT version-controlled.
# ─────────────────────────────────────────────────────────────────────────

# OS / editor junk
.DS_Store
Thumbs.db

# Secrets & environment
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.log*

# ── Binary media — never tracked (these are what bloat a repo) ──
# Images
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tif
*.tiff
*.ico
# Video
*.mp4
*.webm
*.mov
*.mkv
*.avi
# Audio
*.mp3
*.wav
*.ogg
*.m4a
*.aac
*.flac
# Archives & other large blobs
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.psd
*.ai

# Belt-and-suspenders: the whole media folder is off-limits, so nothing
# under assets/ (any format) can ever be committed.
assets/

# Editor / agent config (local only)
.claude/

# Netlify CLI local link state
.netlify/
